# ── WHITELIST .gitignore ─────────────────────────────────────────────────────
# Ignore EVERYTHING, then re-include only the exact files the Railway dashboard
# service needs. This makes it impossible to accidentally commit secrets
# (config.json with Amazon SP-API creds, _archive/ copies, deploy docs that
# contain DB connection strings) or the 150 MB .db files.
#
# The leading "/" anchors each allow-rule to the repo ROOT, so _archive/.../*.py
# and bsr-collector/*.py stay ignored.

*

# config / build
!/.gitignore
!/Procfile
!/requirements.txt
!/.python-version

# app entry + shared Flask app
!/dashboard.py
!/dashboard_app.py
!/dashboard_module1.py
!/dashboard_module2.py
!/dashboard_module3.py
!/dashboard_expenses.py
!/dashboard_channels.py
!/dashboard_calculator.py

# data layer + read-only collector mapping
!/db.py
!/collector_ro.py

# Module 1 library (read-only on Railway)
!/module1_collector.py
!/module1_db.py

# Module 2 (P&L) library
!/pl_db.py
!/pl_cogs.py
!/pl_ads.py
!/pl_postage.py
!/pl_price.py
!/pl_amazon.py
!/pl_tracker.py
!/pl_ppc.py
!/pl_expenses.py
!/ppc_ads_api.py
!/ppc_scheduler.py

# Module 5 (Mirakl: Tesco + B&Q)
!/mirakl_db.py
!/mirakl_client.py
!/mirakl_sync.py
!/mirakl_worker.py
!/dashboard_mirakl.py

# Module 5a (Amazon label & pack-slip pipeline)
!/module5_labels_db.py
!/dashboard_packages.py
!/module5_orders.py
!/dashboard_ship.py
!/dashboard_settings.py

# Module 6 (live Amazon inventory snapshot)
!/module6_inventory.py
!/dashboard_inventory.py

# one-time maintenance triggers (internal-network reprocess, etc.)
!/dashboard_admin.py

# seed CSVs the app reads at boot
!/sku_aliases.csv
!/price_families.csv

# one-off maintenance tool (run manually against the live DB; Railway never runs it)
!/apply_sku_map_master.py
